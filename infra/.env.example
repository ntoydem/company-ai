# Company AI V0 — environment template
# Copy to repo root:  cp infra/.env.example .env
# Values here are placeholders. NEVER commit a real .env.

# ---------------------------------------------------------------------------
# Host paths and ports (used by docker compose)
# ---------------------------------------------------------------------------
# Root directory for all persistent data (bind mounts).
# dev: ./data (relative to repo root)   prod: /srv/company-ai
DATA_ROOT=./data
# Host port of the backend API (open until Caddy arrives in Phase 3.3).
BACKEND_PORT=8000
# Host port of Caddy (Phase 3.3, profile "web").
CADDY_PORT=8080
# UID/GID the backend container runs as (should match the repo owner on the host).
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------------------
# Postgres (container only; port is NOT exposed to the host — use `make psql`)
# ---------------------------------------------------------------------------
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=company_ai

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# Demo "today" (ISO date). All "current / which operating year" logic uses this, not the wall clock.
DEMO_TODAY=2026-09-15
# Initial admin user, created once at startup if it does not exist (password is never updated by seed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# (Phase 1.1) JWT signing secret; generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# ---------------------------------------------------------------------------
# LLM (Phase 0.3) — OpenAI-compatible client, default Gemini
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL_CLASSIFY=gemini-3.5-flash-lite
LLM_MODEL_ANSWER=gemini-3.8-flash
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=2048
# Optional Anthropic client (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings (Phase 3.4) — requires `make up-full` (profile "full", 16 GB VM)
# ---------------------------------------------------------------------------
EMBEDDINGS_ENABLED=false
EMBED_MODEL_ID=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Backup (Phase 5.3)
# ---------------------------------------------------------------------------
BACKUP_SECONDARY_PATH=
