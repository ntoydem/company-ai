# Company AI V0 — environment template
# Copy to repo root:  cp infra/.env.example .env
# Values here are placeholders. NEVER commit a real .env.

# ---------------------------------------------------------------------------
# Host paths and ports (used by docker compose)
# ---------------------------------------------------------------------------
# Root directory for all persistent data (bind mounts).
# dev: ./data (relative to repo root)   prod: /srv/company-ai
DATA_ROOT=./data
# Backend API port inside the compose network only — NOT published on the host since
# Phase 3.3 (ADR-018); kept for the Vite dev proxy target (backend:8000).
BACKEND_PORT=8000
# Host port of Caddy: the web UI and /api/* for everyone (Phase 3.3, part of `make up`).
CADDY_PORT=8080
# UID/GID the backend container runs as (should match the repo owner on the host).
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------------------
# Postgres (container only; port is NOT exposed to the host — use `make psql`)
# ---------------------------------------------------------------------------
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=company_ai

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# Demo "today" (ISO date). All "current / which operating year" logic uses this, not the wall clock.
DEMO_TODAY=2026-09-15
# Initial admin user, created once at startup if it does not exist (password is never updated by seed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
# (Phase 1.1) JWT signing secret (required); generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# (Phase 1.1) Shared password for the four demo accounts (yonetim, finans, hukuk, enerji).
# They have no real access separation until Phase 1.2, so one shared password is enough.
DEMO_USER_PASSWORD=change-me-demo-password
# (Phase 0.2) Max upload size for document ingestion, in MB.
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# LLM (Phase 0.3) — OpenAI-compatible client, default Gemini
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL_CLASSIFY=gemini-3.5-flash-lite
LLM_MODEL_ANSWER=gemini-3.8-flash
LLM_TIMEOUT_S=60
# /api/ask: chunks (pages) handed to the answer model per question (Phase 3.2b: 20 -> 40; Phase 5.1b: 40 -> 80)
RETRIEVAL_TOP_K=80
# Excel engine (Phase 4.2): DuckDB read-only query timeout (s) and result row cap
EXCEL_QUERY_TIMEOUT_S=10
EXCEL_ROW_LIMIT=200
LLM_MAX_OUTPUT_TOKENS=2048
# Thinking budget (minimal|low|medium|high); Gemini bills thinking as output tokens — keep low.
LLM_REASONING_EFFORT=low
# Optional Anthropic client (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# (Phase 3.1) Model for `make prose` (one-time LLM batch that writes seed_data/generator/prose/*.yaml,
# committed to git). `make seed` never calls the LLM — it renders from the committed prose.
PROSE_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Embeddings (Phase 3.4) — requires `make up-full` (profile "full", 16 GB VM)
# ---------------------------------------------------------------------------
EMBEDDINGS_ENABLED=false
EMBED_MODEL_ID=BAAI/bge-m3
# Compose-internal hostname of the `embed` service; never reached while the flag above
# is false.
EMBED_BASE_URL=http://embed:8080
EMBED_TIMEOUT_S=30
# Background embedding backfill loop (app/main.py); only runs when EMBEDDINGS_ENABLED=true.
EMBEDDING_BACKFILL_INTERVAL_S=15
EMBEDDING_BACKFILL_BATCH_SIZE=20

# ---------------------------------------------------------------------------
# Audit log (Phase 3.4, SPEC_06 §1)
# ---------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=90
# Background cleanup loop interval (app/main.py); a DELETE this cheap can safely run
# more often than "daily".
AUDIT_LOG_CLEANUP_INTERVAL_S=21600

# ---------------------------------------------------------------------------
# Backup (Phase 5.3)
# ---------------------------------------------------------------------------
# Local second disk (e.g. the 8 TB HDD) mount path for the weekly mirror copy; leave empty
# to skip. Used only by `make backup ARGS="--sync-secondary"` — this repo does not install
# a cron job, since the right hour (before HDD spindown) is host-specific.
BACKUP_SECONDARY_PATH=
